# ============================================================
# EduPak Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This file (.env.example) IS committed — it documents all
# available config variables with safe defaults.
# ============================================================

# ──────────────────────────────────────────────────────────
# Database (MySQL via XAMPP)
# ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=edupak
DB_USER=root
DB_PASS=
DB_PORT=3306

# ──────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────
# APP_ENV: dev | staging | prod
APP_ENV=dev

# APP_DEBUG: true | false
# Set to false in production to suppress error output
APP_DEBUG=true

# ──────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# In production, 'info' or 'warn' reduces noise
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────
SITE_TITLE=EduPak Learning Hub

# Absolute or relative path to the offline content library
# (mounted drive, USB stick, or local directory)
CONTENT_PATH=/content/

# ──────────────────────────────────────────────────────────
# Deployment
# ──────────────────────────────────────────────────────────
# Secret key for HTTP-triggered deploy endpoints (migrate-runner, content-index).
# Generate a random string and keep it unique per device.
DEPLOY_SECRET=

# Comma-separated list of content directories that must NEVER be
# touched during updates. These contain the multi-terabyte content library.
# Default (if unset): videos,khan,Wiki,Kiwix,images
CONTENT_DIRS=videos,khan,Wiki,Kiwix,images
