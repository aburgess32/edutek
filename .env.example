# ============================================================
# EduPak Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# This file (.env.example) IS committed — it documents all
# available config variables with safe defaults.
# ============================================================

# ──────────────────────────────────────────────────────────
# Database (MySQL via XAMPP)
# ──────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=edupak
DB_USER=root
DB_PASS=
DB_PORT=3306

# ──────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────
# APP_ENV: dev | staging | prod
APP_ENV=dev

# APP_DEBUG: true | false
# Set to false in production to suppress error output
APP_DEBUG=true

# ──────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────
# LOG_LEVEL: debug | info | warn | error
# In production, 'info' or 'warn' reduces noise
LOG_LEVEL=debug

# ──────────────────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────────────────
SITE_TITLE=EduPak Learning Hub

# Absolute or relative path to the offline content library
# (mounted drive, USB stick, or local directory)
CONTENT_PATH=/content/

# ──────────────────────────────────────────────────────────
# Content Link Obfuscation
# ──────────────────────────────────────────────────────────
# BF-CBC cipher key/IV used to obfuscate video/audio/PDF URLs.
# Change these per-deployment for basic URL tamper-resistance.
# Must be the same across all PHP files on the same device.
CONTENT_CIPHER_KEY=hfjfydjnvhbjfi
CONTENT_CIPHER_IV=91011121

# ──────────────────────────────────────────────────────────
# Teacher Registration
# ──────────────────────────────────────────────────────────
# Passphrase teachers must enter to self-register an account.
# Change this per-deployment to prevent unauthorised registrations.
TEACHER_PASSPHRASE=teachwithedutek

