#!/usr/bin/env bash
# =============================================================================
# EduPak Pre-Commit Hook
# =============================================================================
#
# Runs linters on staged files only to keep commits clean.
# Fails the commit if any linter reports errors.
#
# SETUP (one-time, per developer):
#   git config core.hooksPath .githooks
#
# Or add to your shell profile to auto-apply in every clone:
#   git config --global core.hooksPath .githooks
#
# To bypass in an emergency (use sparingly):
#   git commit --no-verify -m "your message"
#
# =============================================================================

set -euo pipefail

# Colours for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

PASS=0
FAIL=1
EXIT_CODE=0

echo ""
echo -e "${CYAN}=== EduPak Pre-Commit Linter ===${RESET}"
echo ""

# =============================================================================
# 1. Collect staged files by type
# =============================================================================
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)
STAGED_JS=$(git diff  --cached --name-only --diff-filter=ACM | grep '\.js$'  || true)
STAGED_CSS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.css$' || true)

# =============================================================================
# 2. PHP_CodeSniffer — PSR-12 on staged .php files
# =============================================================================
if [ -n "$STAGED_PHP" ]; then
    echo -e "${CYAN}[PHP]${RESET} Running PHP_CodeSniffer on staged .php files..."
    echo "$STAGED_PHP" | tr '\n' ' '
    echo ""

    # Prefer local vendor binary; fall back to global phpcs
    if [ -f "vendor/bin/phpcs" ]; then
        PHPCS="vendor/bin/phpcs"
    elif command -v phpcs &>/dev/null; then
        PHPCS="phpcs"
    else
        echo -e "${YELLOW}[PHP] WARNING: phpcs not found. Skipping PHP linting.${RESET}"
        echo -e "${YELLOW}        Run: composer install${RESET}"
        PHPCS=""
    fi

    if [ -n "$PHPCS" ]; then
        # Pass only staged files — not the entire htdocs/ directory
        # shellcheck disable=SC2086
        if echo "$STAGED_PHP" | xargs "$PHPCS" --standard=phpcs.xml --report=full; then
            echo -e "${GREEN}[PHP] PASS${RESET}"
        else
            echo -e "${RED}[PHP] FAIL — Fix PSR-12 violations before committing.${RESET}"
            echo -e "${YELLOW}        Auto-fix with: composer run lint-fix${RESET}"
            EXIT_CODE=$FAIL
        fi
    fi
else
    echo -e "${CYAN}[PHP]${RESET} No staged .php files — skipping."
fi

echo ""

# =============================================================================
# 3. ESLint — ES6+ on staged .js files
# =============================================================================
if [ -n "$STAGED_JS" ]; then
    echo -e "${CYAN}[JS]${RESET}  Running ESLint on staged .js files..."
    echo "$STAGED_JS" | tr '\n' ' '
    echo ""

    if [ -f "node_modules/.bin/eslint" ]; then
        ESLINT="node_modules/.bin/eslint"
    elif command -v eslint &>/dev/null; then
        ESLINT="eslint"
    else
        echo -e "${YELLOW}[JS]  WARNING: eslint not found. Skipping JS linting.${RESET}"
        echo -e "${YELLOW}        Run: npm install${RESET}"
        ESLINT=""
    fi

    if [ -n "$ESLINT" ]; then
        # shellcheck disable=SC2086
        if echo "$STAGED_JS" | xargs "$ESLINT" --no-eslintrc -c .eslintrc.json; then
            echo -e "${GREEN}[JS]  PASS${RESET}"
        else
            echo -e "${RED}[JS]  FAIL — Fix ESLint errors before committing.${RESET}"
            echo -e "${YELLOW}        Auto-fix with: npm run lint:js:fix${RESET}"
            EXIT_CODE=$FAIL
        fi
    fi
else
    echo -e "${CYAN}[JS]${RESET}  No staged .js files — skipping."
fi

echo ""

# =============================================================================
# 4. Stylelint — Standard CSS on staged .css files
# =============================================================================
if [ -n "$STAGED_CSS" ]; then
    echo -e "${CYAN}[CSS]${RESET} Running Stylelint on staged .css files..."
    echo "$STAGED_CSS" | tr '\n' ' '
    echo ""

    if [ -f "node_modules/.bin/stylelint" ]; then
        STYLELINT="node_modules/.bin/stylelint"
    elif command -v stylelint &>/dev/null; then
        STYLELINT="stylelint"
    else
        echo -e "${YELLOW}[CSS] WARNING: stylelint not found. Skipping CSS linting.${RESET}"
        echo -e "${YELLOW}        Run: npm install${RESET}"
        STYLELINT=""
    fi

    if [ -n "$STYLELINT" ]; then
        # shellcheck disable=SC2086
        if echo "$STAGED_CSS" | xargs "$STYLELINT" --config .stylelintrc.json; then
            echo -e "${GREEN}[CSS] PASS${RESET}"
        else
            echo -e "${RED}[CSS] FAIL — Fix Stylelint errors before committing.${RESET}"
            echo -e "${YELLOW}        Auto-fix with: npm run lint:css:fix${RESET}"
            EXIT_CODE=$FAIL
        fi
    fi
else
    echo -e "${CYAN}[CSS]${RESET} No staged .css files — skipping."
fi

echo ""

# =============================================================================
# 5. Final result
# =============================================================================
if [ "$EXIT_CODE" -eq "$PASS" ]; then
    echo -e "${GREEN}All linters passed. Proceeding with commit.${RESET}"
else
    echo -e "${RED}One or more linters failed. Commit aborted.${RESET}"
    echo -e "${YELLOW}Fix the issues above and re-run: git commit${RESET}"
    echo -e "${YELLOW}Emergency bypass (use sparingly): git commit --no-verify${RESET}"
fi

echo ""
exit "$EXIT_CODE"
