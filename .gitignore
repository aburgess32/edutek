# XAMPP infrastructure (not needed in repo)
apache/
mysql/data/
php/
perl/
tomcat/
tmp/
sendmail/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.orig
*.bak

# Logs — keep directory, ignore log files
logs/*.log
*.log

# Environment — NEVER commit .env
.env

# Distribution / build output
dist/

# PHP dependencies
vendor/

# Node dependencies and build cache
node_modules/
.playwright/
test-results/
playwright-report/

# Composer
composer.lock

# Rate-limit temp files (managed at runtime)
/tmp/edupak_ratelimit/

# Passwords (never commit)
passwords.txt

# Content library (too large for git)
htdocs/content/
htdocs/videos/
htdocs/library/
htdocs/images/

# Auto-index runtime data (keep .gitkeep)
htdocs/data/*
!htdocs/data/.gitkeep

# Auto-generated video thumbnails (cached by videoThumb())
**/thumbs/
*.mp4
*.mkv
*.avi
*.webm
*.mov
*.mp3
*.wav
*.ogg
*.flac
*.pdf
*.epub
*.cbz
*.cbr

# Old XAMPP vendor dir (use root composer.json instead)
htdocs/vendor/

# Backup / copy files
*.old
*copy*
*Copy*

# Local backups created during EduTek maintenance
*.before-*
*.backup-*
*.backup

# Local audit and inventory exports
/audiobooks-archive-move-log.csv
/audiobooks-content-audit.csv
/audit-audiobooks.sh
/catalog-category-inventory.txt
/media-indexing-before-merge.patch

# Runtime index status and local page caches
/htdocs/storage/index-status/
/htdocs/storage/comic-books-cache.json

# Temporary cache files
*.tmp
*.temp
# Edutek bulk importer runtime data, secrets and backups (never commit)
**/.env
!.env.example
operator-auth.json
**/operator-auth.json
**/guide_config*
**/*wifi*key*
**/*.psk
*.pem
*.key
*.pfx
*.p12
