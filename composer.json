{
    "name": "edutek/edupak",
    "description": "EduPak Learning Hub — XAMPP-based educational content platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "EduPak\\": "htdocs/includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduPak\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "lint": "phpcs --standard=phpcs.xml",
        "lint-fix": "phpcbf --standard=phpcs.xml",
        "test-coverage": "phpunit --configuration phpunit.xml --coverage-text"
    },
    "scripts-descriptions": {
        "test": "Run all PHPUnit tests",
        "lint": "Run PHP_CodeSniffer linting against PSR-12",
        "lint-fix": "Auto-fix PHP_CodeSniffer violations with PHPCBF",
        "test-coverage": "Run tests with text coverage report"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
