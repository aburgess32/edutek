{
    "name": "edupak",
    "version": "0.1.0",
    "description": "EduPak Learning Hub — XAMPP-based educational content platform",
    "private": true,
    "scripts": {
        "lint:js": "eslint 'htdocs/js/**/*.js'",
        "lint:css": "stylelint 'htdocs/css/**/*.css'",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js:fix": "eslint 'htdocs/js/**/*.js' --fix",
        "lint:css:fix": "stylelint 'htdocs/css/**/*.css' --fix",
        "lint:fix": "npm run lint:js:fix && npm run lint:css:fix",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "test:perf": "lighthouse http://localhost:8080 --output=json --output-path=./reports/lighthouse.json --chrome-flags='--headless' && lighthouse http://localhost:8080 --output=html --output-path=./reports/lighthouse.html --chrome-flags='--headless'"
    },
    "devDependencies": {
        "eslint": "^8.57.0",
        "stylelint": "^16.0.0",
        "stylelint-config-standard": "^36.0.0",
        "@playwright/test": "^1.43.0",
        "lighthouse": "^12.0.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
