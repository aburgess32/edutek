<?xml version="1.0"?>
<ruleset name="EduPak PHP_CodeSniffer Rules">
    <description>PSR-12 coding standard for EduPak XAMPP project</description>

    <!-- Scan htdocs/ only -->
    <file>htdocs/</file>

    <!-- Exclude vendor, node_modules, and third-party libraries -->
    <exclude-pattern>htdocs/vendor/*</exclude-pattern>
    <exclude-pattern>htdocs/node_modules/*</exclude-pattern>
    <exclude-pattern>htdocs/assets/*</exclude-pattern>
    <exclude-pattern>htdocs/fonts/*</exclude-pattern>
    <exclude-pattern>htdocs/fpdf.php</exclude-pattern>
    <exclude-pattern>*/bootstrap*</exclude-pattern>
    <exclude-pattern>*/jquery*</exclude-pattern>
    <exclude-pattern>*.min.js</exclude-pattern>
    <exclude-pattern>*.min.css</exclude-pattern>

    <!-- Use PSR-12 as the base standard -->
    <rule ref="PSR12"/>

    <!-- Exclude side-effects sniff for XAMPP-style utility includes -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>*/includes/*.php</exclude-pattern>
    </rule>

    <!-- Set line length to 120 characters (warning only, no hard limit) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- Show progress and colors in output -->
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- Only check PHP files -->
    <arg name="extensions" value="php"/>

</ruleset>
